# Birdman Picks — every setting name, with placeholders only.
# Never commit real values. Where each one lives in production is in HANDOFF.md, section 6.

# ---- Frontend (Vite; put in .env.local for local dev) ----
# Address of the Birdman server. Leave empty to switch off Record, Pick'em and Pro.
VITE_SERVER_URL=http://localhost:8787

# ---- Server (Cloudflare Worker; for local dev put these in server/.dev.vars) ----
# Plain settings (production values are in server/wrangler.toml)
ALLOWED_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173/

# Secrets
STRIPE_SECRET_KEY=rk_test_your_restricted_key_here
TOKEN_SECRET=any_long_random_string
ADMIN_KEY=owner_password_at_least_16_characters
AGENT_KEY=agent_key_at_least_16_characters

# Optional: Pro restore-by-email
RESEND_API_KEY=re_your_resend_key_here
FROM_EMAIL=Birdman Picks <pro@your-domain.example>

# ---- Pick agent (scripts/run-agent.mjs; GitHub Actions in production) ----
SERVER_URL=http://localhost:8787
# AGENT_KEY (same value as above)

# ---- Optional: automatic server deploys from GitHub Actions ----
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Worker secret only (never VITE_): unique credential for trusted Scout research publishing
# SCOUT_PUBLISH_KEY=<set with wrangler secret put; do not put a real value here>
